# Copy this file to .env and fill in your own Supabase connection string.
# Never commit the real .env file (it's already in .gitignore).

# Supabase: Project Settings -> Database -> Connection string -> "URI"
# (use the "Transaction" pooler connection for DATABASE_URL, port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Direct (non-pooled) connection, used by `prisma migrate` for schema changes.
# Supabase: same page, but the "Session" pooler connection, port 5432.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"
